   "fieldname": "receiving_section",
   "fieldtype": "Section Break",
   "label": "Receiving"
  },
  {
   "description": "Warn the worker when a product arrives with little shelf life left. Example: 30 means warn when less than 30% of the item's shelf life is left (an item that keeps 100 days, arriving with 25 days left). 0 turns the warning off. The item's Shelf Life In Days must be set in ERPNext.",
   "fieldname": "expiry_warning_pct",
   "fieldtype": "Percent",
   "label": "Short Shelf Life Warning (%)"
  },
  {
   "fieldname": "column_break_rcv",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "fieldname": "gs1_enabled",
   "fieldtype": "Check",
   "label": "Read GS1 Barcodes",
   "description": "Read the GTIN, batch and expiry date from GS1-128 and GS1 DataMatrix codes (the long codes on cartons and medicines). The expiry date is filled in for the worker."
  },
  {
   "default": "1",
   "description": "The worker must type the number on the supplier's invoice before sending a shipment for review. It is written on the Purchase Receipt and filled in the Purchase Invoice.",
   "fieldname": "require_supplier_invoice_no",
   "fieldtype": "Check",
   "label": "Require Supplier Invoice No"
  },
  {
   "fieldname": "enable_free_qty",
   "fieldtype": "Check",
   "default": "0",
   "label": "Free Quantity from Supplier Offers",
   "description": "For suppliers who add free goods (for example 12 delivered, 2 of them free). The worker enters how many of the received quantity are free. On approval the Purchase Receipt gets a free row at price 0 linked to a Pricing Rule for the offer, and the item's cost is spread over all the units. Off: the field is not shown."
  },
  {
   "fieldname": "approval_section",
   "fieldtype": "Section Break",
   "label": "Approval"
  },
  {
   "description": "Who can approve receipts, decide over-receipts and wrong items, and send shipments back. Empty: Hasr Supervisor. System Manager can always approve. Nobody approves a shipment they received themselves.",
