   "fieldtype": "Table MultiSelect",
   "label": "Roles That Can Approve",
   "options": "Hasr Approver Role"
  },
  {
   "default": "0",
   "description": "On the Today's Shipments page, a shipment that matches its order can be approved with one click. On: that click also submits the Purchase Receipt and stock moves at once. Off: the receipt stays a draft for someone to check and submit.",
   "fieldname": "quick_approve_submits",
